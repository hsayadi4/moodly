# Copier ce fichier en .env avant le premier lancement : cp .env.example .env
# Les valeurs ci-dessous suffisent pour une démo locale.
# En production, générer de vrais secrets (ex : openssl rand -base64 16).

HOST=0.0.0.0
PORT=1337

# Secrets Strapi
APP_KEYS=devKeyA_change_me,devKeyB_change_me
API_TOKEN_SALT=dev_api_token_salt_change_me
ADMIN_JWT_SECRET=dev_admin_jwt_secret_change_me
TRANSFER_TOKEN_SALT=dev_transfer_salt_change_me
JWT_SECRET=dev_jwt_secret_change_me
ENCRYPTION_KEY=dev_encryption_key_change_me
JWT_EXPIRES_IN=7d

# Base de données (SQLite par défaut, fichier .tmp/data.db)
DATABASE_CLIENT=sqlite

# Moodly
APP_TIMEZONE=Europe/Paris
# Secret utilisé pour pseudonymiser l'auteur d'une humeur (HMAC). Ne jamais le changer après la mise en service.
MOOD_HASH_SECRET=dev-only-change-me-7c1f0e2a9b
# Nombre minimum de réponses pour afficher une moyenne au manager (anonymat)
MIN_GROUP_SIZE=3
# Crée les comptes et 30 jours de données de démo au premier lancement
SEED_DEMO=true
# Origines autorisées (séparées par des virgules), * pour la démo locale
CORS_ORIGINS=*
